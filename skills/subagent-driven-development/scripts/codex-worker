"""
Codex app-server JSON-RPC client, for use INSIDE a room (never by the
orchestrator directly — the room drives Codex, the orchestrator drives the room).

Must-have primitives per operator decision 2026-08-18: turn/steer and
turn/interrupt are first-class, tested against a real in-flight turn (not just
wired and hoped). model/effort are per-task parameters, enumerated from
`model/list` rather than hardcoded (this install's real models, measured
2026-08-18: gpt-5.6-sol [isDefault, efforts low/medium/high/xhigh/max/ultra],
gpt-5.6-terra [same effort ladder, config.toml default]).

Deferred (per operator: "the rest can be deferred"): MCP tool wiring,
review-only mode, multi-worker-per-process sharing, token-budget enforcement.
These are named in room-brief-codex-worker-poc.md as future use cases, not
built here.

Source: codex-app-server-reference.md §17, extended with:
  - notification dispatch by method (not just a raw queue)
  - approval auto-responder (required even with approvalPolicy="never" per §12)
  - non-blocking start_turn() + wait_for_turn(), so steer/interrupt have a real
    window to act on an in-flight turn instead of only being reachable after
    the turn already completed
  - active-turn tracking from turn/started (per §17 closing note: don't trust
    the turn/start response id after a compaction/aux-command may have moved it)

Measured gotchas from this POC (2026-08-18, codex-cli 0.147.0):
  - thread/start takes `sandbox` as a STRING enum; turn/start takes
    `sandboxPolicy` as an OBJECT. Sending the object shape to thread/start is
    silently ignored -> Codex falls back to a read-only sandbox, no error.
  - This server build rejects camelCase sandbox enum values (`workspaceWrite`)
    with -32600; it wants kebab-case (`workspace-write`). The reference doc's
    JSON-RPC examples use camelCase — verify against
    `codex app-server generate-json-schema` on any Codex upgrade rather than
    trusting the doc literally.
  - Codex on this machine auto-discovers and invokes the `superdev` Claude
    plugin's skills mid-turn (visible as agentMessage commentary referencing
    `superdev:using-superdev`) — it is not a blank slate; the room brief must
    account for Codex bringing its own skill-triggering behavior.
"""
from __future__ import annotations

import itertools
import json
import queue
import subprocess
import threading
from dataclasses import dataclass, field
from typing import Any, Callable


@dataclass
class TurnResult:
    turn_id: str
    status: str  # "completed" | "interrupted" | "failed"
    error: dict | None = None
    items: list[dict] = field(default_factory=list)


class CodexAppServer:
    """Newline-delimited JSON-RPC over `codex app-server` stdio."""

    def __init__(
        self,
        cwd: str,
        client_name: str = "superdev_room",
        approval_handler: Callable[[dict], dict] | None = None,
        on_notification: Callable[[dict], None] | None = None,
    ):
        self.proc = subprocess.Popen(
            ["codex", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            cwd=cwd,
        )
        self._ids = itertools.count(1)
        self._pending: dict[int, queue.Queue] = {}
        self._active_turn: dict[str, str] = {}  # threadId -> turnId
        self._turn_futures: dict[str, queue.Queue] = {}  # threadId -> queue of turn/completed events
        self._item_log: dict[str, list[dict]] = {}  # turnId -> completed items (audit trail)
        self._approval_handler = approval_handler or self._default_deny
        self._on_notification = on_notification
        self._closed = False

        threading.Thread(target=self._read_loop, daemon=True).start()
        threading.Thread(target=self._stderr_drain, daemon=True).start()
        self._handshake(client_name)

    # -- transport -----------------------------------------------------

    def _stderr_drain(self):
        for line in self.proc.stderr:
            print(f"[codex stderr] {line.rstrip()}")

    def _read_loop(self):
        for line in self.proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                print(f"[codex client] unparseable line: {line!r}")
                continue
            self._dispatch(msg)
        self._closed = True

    def _send(self, msg: dict):
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def call(self, method: str, params: dict | None = None, timeout: int = 120) -> dict:
        rid = next(self._ids)
        q: queue.Queue = queue.Queue()
        self._pending[rid] = q
        self._send({"method": method, "id": rid, "params": params or {}})
        msg = q.get(timeout=timeout)
        if "error" in msg:
            raise RuntimeError(f"{method} failed: {msg['error']}")
        return msg["result"]

    def notify(self, method: str, params: dict | None = None):
        self._send({"method": method, "params": params or {}})

    def _handshake(self, client_name: str):
        self.call(
            "initialize",
            {
                "clientInfo": {"name": client_name, "title": "Superdev Room", "version": "0.1.0"},
                "capabilities": {
                    "experimentalApi": True,
                    "optOutNotificationMethods": [
                        "item/agentMessage/delta",
                        "item/reasoning/textDelta",
                        "item/reasoning/summaryTextDelta",
                        "item/commandExecution/outputDelta",
                    ],
                },
            },
        )
        self.notify("initialized", {})

    # -- discovery --------------------------------------------------------

    def list_models(self) -> list[dict]:
        """Real available models + supported efforts. Never hardcode a model id —
        this install's model/effort names have already drifted from the reference
        doc once; read them live."""
        return self.call("model/list", {}).get("data", [])

    # -- notification / server-request dispatch -------------------------

    def _dispatch(self, msg: dict):
        method = msg.get("method")

        if "id" in msg and method is None:  # response to a call() we made
            q = self._pending.pop(msg["id"], None)
            if q:
                q.put(msg)
            return

        if "id" in msg and method:  # server-initiated request needing our response
            self._handle_server_request(msg)
            return

        params = msg.get("params", {})

        if method == "turn/started":
            turn = params.get("turn", {})
            thread_id = params.get("threadId") or turn.get("threadId")
            if thread_id and turn.get("id"):
                self._active_turn[thread_id] = turn["id"]

        elif method == "turn/completed":
            turn = params.get("turn", {})
            thread_id = params.get("threadId") or turn.get("threadId")
            if thread_id in self._turn_futures:
                self._turn_futures[thread_id].put(turn)
            if thread_id and self._active_turn.get(thread_id) == turn.get("id"):
                self._active_turn.pop(thread_id, None)

        elif method == "item/completed":
            item = params.get("item", {})
            turn_id = params.get("turnId")
            if turn_id:
                self._item_log.setdefault(turn_id, []).append(item)

        if self._on_notification:
            self._on_notification(msg)

    def _default_deny(self, request: dict) -> dict:
        """Safety-net approval handler: decline anything not explicitly wired.

        Per §12 — approvals must be implemented even with approvalPolicy="never";
        this is the audit-trail net for "unexpected" requests, not the primary gate.
        """
        method = request.get("method")
        print(f"[codex client] AUTO-DECLINE unexpected approval request: {method}")
        if method == "item/commandExecution/requestApproval":
            return {"decision": "decline"}
        if method == "item/fileChange/requestApproval":
            return {"decision": "decline"}
        if method == "tool/requestUserInput":
            return {"answers": []}
        return {}

    def _handle_server_request(self, msg: dict):
        decision = self._approval_handler(msg)
        self._send({"id": msg["id"], "result": decision})

    # -- thread / turn primitives ------------------------------------------

    def start_thread(
        self,
        cwd: str,
        model: str | None = None,
        service_name: str = "superdev_room",
    ) -> dict:
        # thread/start takes `sandbox` as a STRING enum (kebab-case on this
        # build), NOT the `sandboxPolicy` OBJECT — that only applies to
        # turn/start. See module docstring "Measured gotchas".
        params: dict[str, Any] = {
            "cwd": cwd,
            "approvalPolicy": "never",
            "sandbox": "workspace-write",
            "serviceName": service_name,
        }
        if model:
            params["model"] = model
        result = self.call("thread/start", params)
        thread_id = result["thread"]["id"]
        self._turn_futures[thread_id] = queue.Queue()
        return result["thread"]

    def start_turn(
        self,
        thread_id: str,
        text: str,
        cwd: str | None = None,
        model: str | None = None,
        effort: str | None = None,
    ) -> str:
        """Fire a turn and return immediately with its turn_id — does NOT block.

        Required for real steer/interrupt: you need a live turn_id to target
        before the turn finishes. Use wait_for_turn() to block on completion,
        or steer()/interrupt() to act on the in-flight turn first.
        """
        params: dict[str, Any] = {
            "threadId": thread_id,
            "input": [{"type": "text", "text": text}],
        }
        if cwd:
            # OBJECT form, distinct from thread/start's STRING `sandbox` field.
            # Turn-level overrides persist to the thread (reference §8.2).
            params["sandboxPolicy"] = {
                "type": "workspaceWrite",
                "writableRoots": [cwd],
                "networkAccess": False,
            }
        if model:
            params["model"] = model
        if effort:
            params["effort"] = effort

        turn = self.call("turn/start", params)["turn"]
        self._active_turn[thread_id] = turn["id"]
        return turn["id"]

    def wait_for_turn(self, thread_id: str, timeout: int = 900) -> TurnResult:
        completed = self._turn_futures[thread_id].get(timeout=timeout)
        turn_id = completed["id"]
        return TurnResult(
            turn_id=turn_id,
            status=completed.get("status", "unknown"),
            error=completed.get("error"),
            items=self._item_log.get(turn_id, []),
        )

    def run_turn(
        self,
        thread_id: str,
        text: str,
        cwd: str | None = None,
        model: str | None = None,
        effort: str | None = None,
        timeout: int = 900,
    ) -> TurnResult:
        """Convenience: start_turn() + wait_for_turn(). No steer/interrupt window."""
        self.start_turn(thread_id, text, cwd=cwd, model=model, effort=effort)
        return self.wait_for_turn(thread_id, timeout=timeout)

    def steer(self, thread_id: str, text: str) -> bool:
        """Append instructions to the in-flight turn. False if no turn is active.

        Per reference §8.3: fails if there's no active turn (real branch, not a
        fallback); does not accept model/cwd/sandbox overrides — steering changes
        instructions, never configuration.
        """
        active = self._active_turn.get(thread_id)
        if not active:
            return False
        self.call(
            "turn/steer",
            {"threadId": thread_id, "input": [{"type": "text", "text": text}], "expectedTurnId": active},
        )
        return True

    def interrupt(self, thread_id: str) -> bool:
        """Cancel the in-flight turn. False if no turn is active."""
        active = self._active_turn.get(thread_id)
        if not active:
            return False
        self.call("turn/interrupt", {"threadId": thread_id, "turnId": active})
        return True

    def shutdown(self):
        try:
            self.proc.stdin.close()
        except Exception:
            pass
        self.proc.terminate()


if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="Drive a Codex app-server worker for one turn.")
    parser.add_argument("cwd", help="Worktree the worker operates in (absolute path recommended)")
    parser.add_argument("prompt", help="Task prompt for the turn")
    parser.add_argument("--model", default=None, help="Model id (see model/list for real ids)")
    parser.add_argument("--effort", default=None, help="Reasoning effort (low/medium/high/xhigh/max/ultra)")
    parser.add_argument("--list-models", action="store_true", help="Print model/list and exit")
    args = parser.parse_args()

    cx = CodexAppServer(cwd=args.cwd)

    if args.list_models:
        for m in cx.list_models():
            efforts = [e["reasoningEffort"] for e in m.get("supportedReasoningEfforts", [])]
            print(f"{m['id']}: {m.get('description', '')} (efforts: {efforts})")
        cx.shutdown()
        raise SystemExit(0)

    thread = cx.start_thread(cwd=args.cwd, model=args.model)
    print(f"[worker] thread started: {thread['id']}")

    result = cx.run_turn(thread["id"], args.prompt, cwd=args.cwd, model=args.model, effort=args.effort)
    print(f"[worker] turn {result.turn_id} -> {result.status}")
    if result.error:
        print(f"[worker] error: {result.error}")
    for item in result.items:
        if item.get("type") == "agentMessage":
            print(f"[worker] agentMessage[{item.get('phase')}]: {item.get('text')}")

    cx.shutdown()
